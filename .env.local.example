# ══════════════════════════════════════════════════════════════
#  Copie ce fichier en ".env.local" et remplis les valeurs.
#  (Supabase → Project Settings → API)
# ══════════════════════════════════════════════════════════════

# URL du projet Supabase (ex: https://xxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Clé "anon public" — utilisée par le formulaire de contact
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clé "service_role" (SECRÈTE) — utilisée uniquement par le dashboard côté serveur
SUPABASE_SERVICE_ROLE_KEY=

# Mot de passe d'accès au dashboard /dashboard
DASHBOARD_PASSWORD=
